{
  "name": "GeneLab RNAseq Training",
  "image": "quay.io/nasa_genelab/gl4u:gl4u_rnaseq",
  
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": {
      "label": "Jupyter",
      "requireLocalPort": true,
      "onAutoForward": "ignore"
    }
  },
  
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/gitpod/miniconda3/envs/gl4u_rnaseq_2024/bin/python"
      }
    }
  }
}